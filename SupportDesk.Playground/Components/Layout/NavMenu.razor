@inject SupportDesk.Playground.Services.UserSession Session
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">SupportDesk</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @if (!Session.IsLoggedIn)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-person" aria-hidden="true"></span>Login
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="signup">
                    <span class="bi bi-person-plus" aria-hidden="true"></span>Signup
                </NavLink>
            </div>
        }
        else if (Session.IsAdmin)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/pending-approvals">
                    <span class="bi bi-clock-history" aria-hidden="true"></span>Pending Approvals
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/support-bot">
                    <span class="bi bi-robot" aria-hidden="true"></span>SupportBot
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <button class="nav-link btn btn-link text-start w-100" @onclick="Logout">
                    <span class="bi bi-box-arrow-right" aria-hidden="true"></span>Logout
                </button>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="user/my-orders">
                    <span class="bi bi-bag" aria-hidden="true"></span>My Orders
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="user/support-bot">
                    <span class="bi bi-robot" aria-hidden="true"></span>Support Bot
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <button class="nav-link btn btn-link text-start w-100" @onclick="Logout">
                    <span class="bi bi-box-arrow-right" aria-hidden="true"></span>Logout
                </button>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
    }

    private void OnSessionChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void Logout()
    {
        Session.SignOut();
        NavigationManager.NavigateTo("/login");
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
    }
}
