@page "/admin/support-bot"
@rendermode InteractiveServer
@inject SupportDesk.Playground.Services.UserSession Session

<PageTitle>SupportBot</PageTitle>

@if (!Session.IsLoggedIn || !Session.IsAdmin)
{
	<h1>Unauthorized</h1>
	<p>Only admin users can view this page.</p>
}
else
{
	<h1>SupportBot</h1>
	<p>This is the admin support bot view.</p>
	<a class="btn btn-primary" href="/playground">Open Chat</a>
}
