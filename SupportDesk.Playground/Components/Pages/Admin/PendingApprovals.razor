@page "/admin/pending-approvals"
@rendermode InteractiveServer
@inject SupportDesk.Playground.Services.UserSession Session

<PageTitle>Pending Approvals</PageTitle>

@if (!Session.IsLoggedIn || !Session.IsAdmin)
{
	<h1>Unauthorized</h1>
	<p>Only admin users can view this page.</p>
}
else
{
	<h1>Pending Approvals</h1>
	<p>This is the admin view for pending approval requests.</p>
}
